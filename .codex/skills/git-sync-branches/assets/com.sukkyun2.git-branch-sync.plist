<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sukkyun2.git-branch-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/.codex/logs" &amp;&amp; exec "$HOME/.codex/skills/git-sync-branches/scripts/sync-branches.sh" "$HOME/Desktop/workspaces" &gt;&gt; "$HOME/.codex/logs/git-sync-branches.log" 2&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
